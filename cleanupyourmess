#!/bin/bash
# cleanup-frontend.sh – Remove only the dashboard and isolated Node.js 18
# Run with: sudo ./cleanup-frontend.sh

set -euo pipefail

log_info()  { echo -e "\033[0;32m[INFO]\033[0m $1"; }
log_warn()  { echo -e "\033[1;33m[WARN]\033[0m $1"; }
log_error() { echo -e "\033[0;31m[ERROR]\033[0m $1"; exit 1; }

# Detect real user
if [ -n "${SUDO_USER:-}" ]; then
    REAL_USER="$SUDO_USER"
    REAL_HOME=$(eval echo ~"$REAL_USER")
else
    REAL_USER=$(whoami)
    REAL_HOME="$HOME"
fi

DASHBOARD_DIR="$REAL_HOME/Desktop/foundation-mining-dashboard"
NODE18_DIR="/opt/nodejs-18"

echo ""
log_warn "This script will remove the frontend dashboard and isolated Node.js 18."
log_warn "It will NOT remove the pool (foundation-v1-server) or its dependencies."
echo "It will stop the 'mining-dashboard' PM2 process (if running), delete the dashboard directory,"
echo "and remove /opt/nodejs-18. Then it will restart the pool service."
echo ""
read -p "Are you sure you want to proceed? (yes/no): " CONFIRM
if [ "$CONFIRM" != "yes" ]; then
    log_info "Cleanup cancelled."
    exit 0
fi

# 1. Stop PM2 process (if PM2 exists)
if command -v pm2 &> /dev/null; then
    if pm2 list | grep -q "mining-dashboard"; then
        log_info "Stopping and removing PM2 process: mining-dashboard"
        pm2 stop mining-dashboard 2>/dev/null || true
        pm2 delete mining-dashboard 2>/dev/null || true
        pm2 save --force 2>/dev/null || true
    else
        log_warn "PM2 process 'mining-dashboard' not found."
    fi
else
    # If PM2 not found, try to kill any node process running server.js in dashboard dir
    if [ -d "$DASHBOARD_DIR" ]; then
        log_info "PM2 not found, killing any node process running server.js from dashboard directory..."
        pkill -f "node.*$DASHBOARD_DIR.*server.js" 2>/dev/null || true
    fi
fi

# 2. Remove dashboard directory
if [ -d "$DASHBOARD_DIR" ]; then
    log_info "Removing dashboard directory: $DASHBOARD_DIR"
    rm -rf "$DASHBOARD_DIR"
else
    log_warn "Dashboard directory not found: $DASHBOARD_DIR"
fi

# 3. Remove isolated Node.js 18
if [ -d "$NODE18_DIR" ]; then
    log_info "Removing isolated Node.js 18 installation: $NODE18_DIR"
    rm -rf "$NODE18_DIR"
else
    log_warn "Isolated Node.js 18 directory not found: $NODE18_DIR"
fi

# 4. Restart the pool service (to ensure it's running with Node.js 14)
if systemctl list-units --full --all | grep -q "foundation-server.service"; then
    log_info "Restarting foundation-server.service..."
    sudo systemctl restart foundation-server.service
    log_info "Pool restarted successfully."
else
    log_warn "foundation-server.service not found. Pool may not be installed."
fi

log_info "Cleanup completed successfully."
log_info "The pool should now be running with Node.js 14 only."
